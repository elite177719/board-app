# 서버 포트
PORT=8080
HOST=127.0.0.1

# 프록시(Nginx/ALB) 뒤 운영에서만 설정하세요. 예) 1, loopback, 10.0.0.0/8
# 비워두면 trust proxy=false로 동작합니다.
TRUST_PROXY=1

# HTTPS 뒤에서 세션 쿠키를 발행할 때 true로 설정하세요.
SESSION_COOKIE_SECURE=true

# MariaDB 접속 정보 (이미 설정한 값으로 맞추세요)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=boarddb
DB_USER=admin
DB_PASSWORD=test

# 로그인 세션 암호화 키 (32자 이상 임의의 문자열로 변경하세요)
SESSION_SECRET=change-this-to-a-long-random-string-32chars-min

# 최초 실행 시 자동 생성되는 관리자 계정
ADMIN_USERNAME=admin
ADMIN_PASSWORD=test
